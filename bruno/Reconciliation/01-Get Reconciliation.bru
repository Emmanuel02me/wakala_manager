meta {
  name: Get Reconciliation
  type: http
  seq: 1
}

auth:bearer {
  token: {{token}}
}

get {
  url: {{baseUrl}}/api/reconciliation/session/{{sessionId}}
  body: none
  auth: bearer
}

tests {
  test("Status is 200", function() {
    expect(res.status).to.equal(200);
  });
  test("totalInstantProfit is 300", function() {
    expect(res.body.totalInstantProfit).to.equal(300);
  });
}