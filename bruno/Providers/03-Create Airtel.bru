meta {
  name: Create Airtel
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/providers
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Airtel Money",
    "type": "MOBILE_MONEY"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("airtelProviderId", res.body.id);
  }
}