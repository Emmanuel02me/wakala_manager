meta {
  name: Create CRDB
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/providers
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "CRDB",
    "type": "BANK"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("crdbProviderId", res.body.id);
  }
}