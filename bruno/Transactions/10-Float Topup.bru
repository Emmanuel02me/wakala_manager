meta {
  name: Float Topup
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/transactions
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "sessionId": {{sessionId}},
    "userId": {{employeeId}},
    "providerId": {{mpesaProviderId}},
    "transactionType": "FLOAT_TOPUP",
    "amount": 50000,
    "reference": "TOPUP-MIDDAY"
  }
}

tests {
  test("floatEffect is +50000", function() {
    expect(res.body.floatEffect).to.equal(50000);
  });
  test("cashEffect is -50000", function() {
    expect(res.body.cashEffect).to.equal(-50000);
  });
}
