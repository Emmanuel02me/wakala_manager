meta {
  name: Float Withdraw
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/transactions
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "sessionId": {{sessionId}},
    "userId": {{employeeId}},
    "providerId": {{mpesaProviderId}},
    "transactionType": "FLOAT_WITHDRAW",
    "amount": 30000,
    "reference": "WD-MIDDAY"
  }
}
