meta {
  name: Record Lipa Namba
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/transactions
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "sessionId": {{sessionId}},
    "userId": {{employeeId}},
    "providerId": {{mpesaProviderId}},
    "transactionType": "LIPA_NAMBA",
    "amount": 50000,
    "customerName": "Duka la John"
  }
}

tests {
  test("Status is 201", function() {
    expect(res.status).to.equal(201);
  });
}
