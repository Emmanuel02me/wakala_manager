meta {
  name: Create Rule 10k-50k
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/commission-rules
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "providerId": {{mpesaProviderId}},
    "transactionType": "LIPA_CASH_OUT",
    "minAmount": 10001,
    "maxAmount": 50000,
    "networkCommission": 500,
    "ownerCommission": 600,
    "createdByUserId": {{ownerId}},
    "effectiveFrom": "2026-09-01"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("ruleId2", res.body.id);
  }
}