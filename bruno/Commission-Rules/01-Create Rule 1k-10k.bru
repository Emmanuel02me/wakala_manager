meta {
  name: Create Rule 1k-10k
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/commission-rules
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "providerId": {{mpesaProviderId}},
    "transactionType": "LIPA_CASH_OUT",
    "minAmount": 1000,
    "maxAmount": 10000,
    "networkCommission": 200,
    "ownerCommission": 300,
    "createdByUserId": {{ownerId}},
    "effectiveFrom": "2026-09-01",
    "notes": "Lipa Namba range ya chini"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("ruleId1", res.body.id);
  }
}