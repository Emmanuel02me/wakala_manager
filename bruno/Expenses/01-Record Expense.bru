meta {
  name: Record Expense
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/expenses
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "sessionId": {{sessionId}},
    "userId": {{employeeId}},
    "description": "Usafiri wa mteja",
    "amount": 5000,
    "category": "USAFIRI"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("expenseId", res.body.id);
  }
}